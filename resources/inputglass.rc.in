#include <windows.h>
#include "resource.h"

IDI_INPUTGLASS ICON "@INPUTGLASS_ICON@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@INPUTGLASS_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "InputGlass contributors\0"
            VALUE "FileDescription", "Windows input diagnostic dashboard\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "InputGlass\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 arro000\0"
            VALUE "OriginalFilename", "InputGlass.exe\0"
            VALUE "ProductName", "InputGlass\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
