set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

if(DEFINED ENV{CC} AND NOT "$ENV{CC}" STREQUAL "")
    set(CMAKE_C_COMPILER "$ENV{CC}" CACHE FILEPATH "C cross-compiler")
else()
    set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc CACHE FILEPATH "C cross-compiler")
endif()

if(DEFINED ENV{RC} AND NOT "$ENV{RC}" STREQUAL "")
    set(CMAKE_RC_COMPILER "$ENV{RC}" CACHE FILEPATH "Windows resource compiler")
else()
    set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres CACHE FILEPATH "Windows resource compiler")
endif()

set(CMAKE_FIND_ROOT_PATH /usr/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
